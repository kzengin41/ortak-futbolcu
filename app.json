{
  "expo": {
    "name": "3-2-1: Bitir İşi",
    "slug": "ortak-futbolcu",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2f3d3e94-c554-4e05-9cda-fe6f752c1b08",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1613",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kerem.ortakfutbolcu",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Oyuncu isimlerini sesli olarak tahmin edebilmeniz için mikrofona ihtiyacımız var.",
        "NSPhotoLibraryUsageDescription": "Profil fotoğrafı seçebilmen için galerine erişmemiz gerekiyor. Fotoğraf sadece senin profilinde kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.kerem.ortakfutbolcu",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1613"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1613",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sesle cevap verebilmen için mikrofonuna erişmemiz gerekiyor.",
          "speechRecognitionPermission": "Söylediğin futbolcu adını anında yazıya çevirmek için konuşma tanıma kullanıyoruz.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ],
      "expo-image",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı seçebilmen için galerine erişmemiz gerekiyor."
        }
      ],
      "./plugins/withPaketAdiDuzelt",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "kont-studio",
          "project": "bitir-isi",
          "note": "SENTRY_AUTH_TOKEN yalnizca EAS ortam degiskeninde (Sensitive)."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2f3d3e94-c554-4e05-9cda-fe6f752c1b08"
      }
    }
  }
}
